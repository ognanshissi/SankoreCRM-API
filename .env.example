# ─────────────────────────────────────────────────────────────────────────────
# GABARIT. Copier en `.env` et renseigner, puis NE PAS committer le `.env`.
#
#   cp .env.example .env
#   # puis, pour chaque clé vide ci-dessous :
#   openssl rand -base64 32
#
# Toute variable dont le nom contient KEY, PASSWORD, APIKEY, SIGNING ou HASH est laissée VIDE
# ici délibérément : ce fichier-ci est suivi par git, le `.env` ne doit pas l'être.
# ─────────────────────────────────────────────────────────────────────────────

# ── Images et registre ──────────────────────────────────────────────────────
# Préfixe de registre, avec le slash final. Vide = images locales.
DOCKER_REGISTRY=

# ── Ports publiés sur l'hôte ────────────────────────────────────────────────
# Le port d'ÉCOUTE dans le conteneur, et le port publié sur la machine. Les deux étaient
# confondus : l'API déclarait `HTTP_PORTS=8080` et `ASPNETCORE_HTTP_PORTS=5080` en même temps,
# deux réglages du même port avec deux valeurs.
SANKORE_API_PORT=8080
SANKORE_API_PUBLISHED_PORT=18080

# DÉPLACÉES. Le registre de tenants a sa propre pile (`docker-compose.admin.yml`) et son propre
# gabarit d'environnement (`.env.admin.example`) : ces deux-ci n'y sont plus lues ici, et sont
# laissées en commentaire pour ne pas laisser croire que ce fichier pilote encore ce service.
# SANKORE_ADMIN_PORT=8080
# SANKORE_ADMIN_PUBLISHED_PORT=18200

SANKORE_HANGFIRE_PORT=8080
SANKORE_HANGFIRE_PUBLISHED_PORT=18300

# Bases de données, publiées sur la boucle locale pour un tunnel SSH (voir runbook §15). Ce
# sont les ports de l'HÔTE : dans la pile, les deux instances restent sur 5432.
POSTGRES_PUBLISHED_PORT=18432
# `ADMIN_POSTGRES_PUBLISHED_PORT` a suivi le registre dans `.env.admin.example`. Le port 18433
# y est inchangé, donc le tunnel SSH du §15 du runbook fonctionne comme avant.

# Bloc 18xxx délibérément à l'écart : 5080 et 5200 sont pris par `dcp`, le plan de contrôle
# d'Aspire, et 5341 / 1080 / 3000 / 15672 par d'autres piles Docker de la machine. Avec ces
# ports-là, la pile Compose et un `dotnet run` de l'AppHost peuvent tourner en même temps.

# Outils : tableau de bord Aspire, Seq, maildev, Grafana, RabbitMQ.
ASPIRE_DASHBOARD_PUBLISHED_PORT=18888
SEQ_PUBLISHED_PORT=18341
MAILDEV_PUBLISHED_PORT=18180
GRAFANA_PUBLISHED_PORT=18030
RABBITMQ_MANAGEMENT_PUBLISHED_PORT=18672

# ── Exposition des outils ───────────────────────────────────────────────────
# Adresse de liaison des ports des OUTILS (Grafana, Seq, maildev, RabbitMQ, tableau de bord
# Aspire). `127.0.0.1` = joignables depuis cette machine seulement. Mettre `0.0.0.0` pour les
# ouvrir au réseau, en sachant que Grafana est en anonyme et Seq sans authentification, et que
# maildev contient les jetons de réinitialisation de mot de passe.
TOOLS_BIND_ADDRESS=127.0.0.1

# ── Domaines publics des outils (Traefik / Dokploy) ─────────────────────────
# Un sous-domaine par outil, chacun avec un enregistrement DNS `A` vers l'hôte Dokploy. Le
# DNS doit résoudre AVANT le déploiement : Traefik demande le certificat Let's Encrypt au
# premier appel du domaine, et un échec de validation se garde en cache un moment.
#
# Laisser une valeur VIDE n'éteint pas la route — le `:-` du compose retombe sur un
# `*.localhost` inerte. Pour ne PAS publier un outil, retirer ses labels `traefik.*` du
# compose, ou mettre `traefik.enable: "false"`.
#
# maildev n'est délibérément PAS dans cette liste : il capture le courrier sortant, donc les
# jetons d'activation et de réinitialisation de mot de passe. Il reste joignable par le
# tunnel SSH, et c'est le bon niveau d'exposition pour lui.
TOOLS_DOMAIN_GRAFANA=grafana.ops.example.com
TOOLS_DOMAIN_SEQ=seq.ops.example.com
TOOLS_DOMAIN_HANGFIRE=jobs.ops.example.com
TOOLS_DOMAIN_RABBITMQ=mq.ops.example.com
TOOLS_DOMAIN_ASPIRE=aspire.ops.example.com

# Identifiants de l'authentification HTTP posée par Traefik devant les cinq outils. Format
# htpasswd, plusieurs comptes séparés par des virgules. Générer sans installer htpasswd :
#
#   docker run --rm httpd:2.4-alpine htpasswd -nbB ops 'MotDePasseFort'
#
# ATTENTION au `$` : un hash bcrypt commence par `$2y$...`, et Compose lit `$2y` comme une
# variable. DOUBLER chaque `$` en l'écrivant ici — `$$2y$$10$$...` — puis vérifier que la
# valeur finale n'en a plus qu'un seul :
#
#   docker compose config | grep basicauth.users
#
# Vide = Traefik refuse le middleware, donc refuse le routeur : les domaines ne répondent
# pas. L'échec est volontairement fermé, pour qu'un oubli ne publie jamais Seq ou Hangfire
# sans mot de passe.
TOOLS_BASICAUTH_USERS=

# Grafana : `Viewer` en anonyme, jamais `Admin` — un administrateur peut créer une source de
# données et faire émettre des requêtes depuis le conteneur vers le réseau interne. Mettre
# `false` pour exiger une connexion.
GRAFANA_ANONYMOUS_ENABLED=true

# Seq : sans authentification pour une pile locale. Pour un déploiement partagé, poser le hash
# (`seqcli hash`) et passer ceci à `False`.
SEQ_NO_AUTHENTICATION=True
SEQ_ADMIN_PASSWORD_HASH=

# ── Mots de passe de l'infrastructure ───────────────────────────────────────
POSTGRES_PASSWORD=
RABBITMQ_PASSWORD=
REDIS_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# Tableau de bord Hangfire. Il pointe sur la MÊME base que l'API et refuse toute requête sans
# mot de passe — la valeur était codée en dur dans le compose.
HANGFIRE_DASHBOARD_USERNAME=admin
HANGFIRE_DASHBOARD_PASSWORD=

# ── Montages de configuration d'observabilité ───────────────────────────────
# Les quatre étaient VIDES, ce qui faisait monter le répertoire courant à la place du fichier
# attendu. Les fichiers existent dans le dépôt.
TEMPO_BINDMOUNT_0=./observability/tempo.yaml
PROMETHEUS_BINDMOUNT_0=./observability/prometheus.yml
GRAFANA_BINDMOUNT_0=./observability/grafana/provisioning
GRAFANA_BINDMOUNT_1=./observability/grafana/dashboards

# ═══════════════════════════════════════════════════════════════════════════
# Sankore.Api — configuration
# ═══════════════════════════════════════════════════════════════════════════

# ── Jetons d'authentification ───────────────────────────────────────────────
# Au moins 32 octets. `appsettings.json` porte un littéral
# « CHANGE_ME_use_dotnet_user-secrets_... » qui est lu si celle-ci est vide.
JWT_SIGNING_KEY=
JWT_ISSUER=https://auth.sankore-crm.local
JWT_AUDIENCE=sankore-crm-api

# ── Coffre de secrets (AES-256-GCM) ─────────────────────────────────────────
# Protège chaque identifiant par tenant : mots de passe SMTP, clés d'API, secrets de sources
# de leads. L'API REFUSE DE DÉMARRER sans une valeur valide, et la perdre rend indéchiffrable
# tout secret déjà stocké — à sauvegarder, à ne pas faire tourner à la légère.
SECRETS_ENCRYPTION_KEY=

# ── Chiffrement de champs et index aveugles, par module ─────────────────────
# Une clé par module, délibérément : une clé compromise doit ouvrir un module, pas le dépôt.
# Validées à la PREMIÈRE UTILISATION et non au démarrage, donc une clé absente se manifeste
# par une écriture en échec, pas par un démarrage en échec.
CUSTOMERS_FIELD_ENCRYPTION_KEY=
CUSTOMERS_BLIND_INDEX_KEY=

LEADS_FIELD_ENCRYPTION_KEY=
LEADS_BLIND_INDEX_KEY=

KYC_FIELD_ENCRYPTION_KEY=
KYC_BLIND_INDEX_KEY=

INTEGRATION_FIELD_ENCRYPTION_KEY=
INTEGRATION_BLIND_INDEX_KEY=

# ── Magasins d'objets chiffrés ──────────────────────────────────────────────
# Cinq préoccupations, cinq clés : imagerie KYC, magasin de fichiers, fichiers de lots, pièces
# de sinistre, enregistrements d'appels. Une clé compromise ouvre une préoccupation.
#
# Les BasePath pointent sur des volumes nommés. Par défaut ils atterrissent sous la racine de
# contenu de l'application, qu'un redéploiement détruit — c'est-à-dire que les images KYC et
# les enregistrements d'appels seraient perdus à chaque mise à jour.
KYC_STORAGE_ENCRYPTION_KEY=
FILESTORE_ENCRYPTION_KEY=
INTEGRATION_BATCH_STORAGE_ENCRYPTION_KEY=
INTEGRATION_CLAIMSTORAGE_ENCRYPTION_KEY=

# Enregistrements d'appels (TEL-B-16). VIDE par défaut, et c'est voulu : le magasin n'est
# enregistré que si cette clé est présente, et la politique d'enregistrement est livrée
# `Disabled`. Un déploiement qui n'enregistre aucun appel n'a ni clé, ni volume, ni lecteur.
# La renseigner pour travailler sur la fonctionnalité — et noter que la perdre rend chaque
# enregistrement stocké inouvrable alors que le fournisseur a pu supprimer sa propre copie.
TELEPHONY_RECORDINGS_ENCRYPTION_KEY=

# ── Référentiel de tenants ──────────────────────────────────────────────────
# Le registre est une pile à part (`docker-compose.admin.yml`), mais ce nom d'hôte reste le bon
# tant que les deux piles sont sur `dokploy-network` : Compose pose le nom de chaque service en
# alias DNS sur chaque réseau qu'il rejoint, projets Compose distincts ou non. À remplacer par
# son URL publique UNIQUEMENT si le registre part sur une autre machine.
TENANTSTORE_BASEURL=http://sankore-admin:8080/
# Doit valoir exactement le `SANKORE_API_KEY` du `.env.admin` : c'est la clé que le registre
# exige sur chaque appel, et il ne valide RIEN si la sienne est vide.
TENANTSTORE_APIKEY=
SANKORE_API_KEY=

# ── Tenant par défaut et utilisateur système ────────────────────────────────
# Provisionnés AU DÉMARRAGE : `TenantSeeder` (Sankore.Admin) crée le tenant, puis
# `SystemUserSeeder` (Sankore.Api) crée son utilisateur système en envoyant la même commande
# que `POST /api/v1/users/create-root`. C'est ce qui remplace les deux `curl` du §6 de
# docs/deployment-dokploy.md. Les deux sont idempotents : un redéploiement ne réécrit rien.
#
# LE PIÈGE, et c'est le seul qui compte ici : `DEFAULT_TENANT_FQDN` est l'ORIGINE DU FRONT,
# SCHÉMA COMPRIS — `https://crm.example.com`. Pas un hôte nu, et PAS l'hôte de l'API. Le
# navigateur estampille chaque appel avec `location.origin` (`tenant.interceptor.ts` côté
# SankoreFront) et la recherche compare la chaîne ENTIÈRE : un hôte nu n'est jamais trouvé, et
# le symptôme est une 400 « Cannot determine tenant » sur chaque requête, sans rien d'anormal
# dans les journaux. Les seeders refusent d'ailleurs une valeur sans schéma.
# `DEFAULT_TENANT_NAME` et `DEFAULT_TENANT_EMAIL` ne sont lues que par le seeder du REGISTRE :
# elles vivent désormais dans `.env.admin`. `DEFAULT_TENANT_FQDN` reste ici parce que l'API la
# lit aussi (`SystemUser__TenantFqdn`) — et les deux fichiers doivent porter la MÊME valeur,
# sinon le seeder de l'API ne retrouve pas dans le registre le tenant qu'il provisionne.
DEFAULT_TENANT_FQDN=https://crm.example.com
#
# À FIGER dès que le déploiement conserve des données, mais PAS AU HASARD : chaque ligne de la
# base de l'API porte cet identifiant. Laisser vide au premier démarrage, lire l'identifiant
# dans les journaux d'Admin (« TenantSeeder: provisioned tenant <id> ») ou dans
# `GET /api/v1/tenants`, puis le coller ici. Un registre reconstruit sans lui en génère un
# nouveau, et tout l'historique devient invisible pour un tenant qui, vu de l'extérieur, est le
# même. Un identifiant qui ne correspond à aucun tenant existant est ignoré avec un
# avertissement, jamais imposé.
#
# Elle est lue par le REGISTRE : c'est dans `.env.admin` qu'elle se pose maintenant.
# DEFAULT_TENANT_ID=
#
# Mot de passe de l'utilisateur système. VIDE DÉSACTIVE TOUT LE SEEDER, et c'est le défaut :
# un déploiement qui n'en veut pas garde la voie manuelle. Doit satisfaire la politique
# Identity — 8 caractères, une majuscule, une minuscule, un chiffre, un caractère non
# alphanumérique — vérifiée au démarrage, qui dit ce qui manque.
SYSTEM_USER_PASSWORD=
# Vide : `DEFAULT_TENANT_EMAIL`, tel qu'enregistré dans le registre, fait alors office de
# défaut. À ne renseigner que pour dissocier le compte technique de l'adresse du tenant.
SYSTEM_USER_EMAIL=
SYSTEM_USER_FIRSTNAME=System
SYSTEM_USER_LASTNAME=Sankore

# ── CORS ────────────────────────────────────────────────────────────────────
# Le front en développement. « * » est refusé au démarrage : la politique autorise les
# identifiants, et les deux sont incompatibles.
#
# EN DÉPLOIEMENT (Dokploy ou autre) : remplacer par l'ORIGINE EXACTE du front — schéma,
# hôte, et port s'il n'est pas celui du schéma, sans slash final
# (`https://crm.example.com`). Ces valeurs-ci sont des origines de développement ; laissées
# en place, l'API répond sans en-tête CORS au front déployé et le navigateur bloque chaque
# appel, avec une 200 côté serveur et rien dans les journaux qui désigne la cause.
CORS_ALLOWED_ORIGIN_0=http://localhost:4222
CORS_ALLOWED_ORIGIN_1=https://localhost:4200

# ── Swagger ─────────────────────────────────────────────────────────────────
# `appsettings.json` le laisse à `true` avec « james / 123456 » en clair. Hors développement
# il n'est servi que derrière une authentification HTTP Basic, et répond 503 tant que le mot
# de passe n'est pas posé. Le laisser à `false` ailleurs qu'en développement.
SWAGGER_ENABLED=true
SWAGGER_AUTH_USERNAME=sankore
SWAGGER_AUTH_PASSWORD=

# ── Antivirus des pièces de sinistre ────────────────────────────────────────
# hôte:port d'un clamd. NON RENSEIGNÉ par défaut, et c'est le défaut fermé : sans analyseur,
# chaque pièce est enregistrée `ScanFailed` et RIEN n'est transmis à un assureur. Un
# déploiement qui distribue de l'assurance doit le renseigner.
INTEGRATION_ANTIVIRUS_ADDRESS=

# ── Stockage objet Cloudflare R2 ────────────────────────────────────────────
# Support des cinq magasins d'objets : un bucket R2 par préoccupation si renseigné, les
# volumes Docker locaux sinon. Orthogonal au chiffrement — les clés ci-dessus s'appliquent
# dans les deux cas.
#
# LES TROIS ENSEMBLE OU AUCUNE : une seule renseignée fait échouer le démarrage de l'API en
# nommant la clé manquante. C'est voulu — une configuration à moitié faite est une erreur,
# pas un choix, et retomber sur un volume ferait disparaître les pièces KYC au redéploiement
# sans que rien ne le signale.
#
# Les cinq buckets doivent exister chez R2 AVANT, nommés exactement : kyc-documents,
# imports, integration-batch-files, insurance-claim-documents, telephony-recordings.
# L'API ne les crée pas ; un bucket absent se manifeste par un envoi en échec.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Vide en R2 normal : dérivé en `https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com`. Ne
# renseigner que pour un service compatible S3 qui n'est pas R2 (MinIO), ou un point de
# terminaison R2 régional.
R2_SERVICE_URL=
