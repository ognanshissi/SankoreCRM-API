# ─────────────────────────────────────────────────────────────────────────────
# GABARIT de la pile AUTONOME du référentiel de tenants (`docker-compose.admin.yml`).
#
#   cp .env.admin.example .env.admin
#   docker compose -f docker-compose.admin.yml --env-file .env.admin up -d --build
#
# Ce fichier ne contient QUE ce que le registre lit. Le reste — API, Hangfire, courtier,
# observabilité, clés de chiffrement des modules — reste dans `.env`.
#
# TROIS valeurs doivent être IDENTIQUES de part et d'autre, sans quoi la séparation casse en
# silence. Elles sont marquées « ↔ pile API » ci-dessous.
#
# Toute variable dont le nom contient KEY, PASSWORD ou APIKEY est laissée VIDE ici : ce
# fichier-ci est suivi par git, le `.env.admin` ne doit pas l'être.
# ─────────────────────────────────────────────────────────────────────────────

# ── Images et registre ──────────────────────────────────────────────────────
# Préfixe de registre, avec le slash final. Vide = images construites localement.
DOCKER_REGISTRY=

# ── Ports ───────────────────────────────────────────────────────────────────
# Le port d'ÉCOUTE dans le conteneur, puis le port publié sur la machine.
SANKORE_ADMIN_PORT=8080
SANKORE_ADMIN_PUBLISHED_PORT=18200
ADMIN_POSTGRES_PUBLISHED_PORT=18433

# Adresse de liaison des ports publiés. `127.0.0.1` = joignables depuis cette machine
# seulement, ce qui est le bon réglage : le registre est atteint par `dokploy-network`, pas par
# ces ports, qui ne servent qu'aux tunnels SSH d'administration.
TOOLS_BIND_ADDRESS=127.0.0.1

# ── Base du registre ────────────────────────────────────────────────────────
# Sur une installation EXISTANTE : poser la MÊME valeur que `POSTGRES_PASSWORD` du `.env`
# principal. Le volume a été initialisé avec celle-là, et Postgres n'en acceptera pas d'autre
# — le symptôme est une authentification refusée au démarrage, pas une réinitialisation.
ADMIN_POSTGRES_PASSWORD=

# Laisser vide pour le conteneur `admin-postgres` de ce fichier. À renseigner avec l'hôte
# interne d'une base GÉRÉE (Dokploy, fournisseur) pour s'en passer — le `required: false` du
# `depends_on` permet alors de supprimer le service.
# ADMIN_POSTGRES_HOST=
# ADMIN_POSTGRES_PORT=5432
# ADMIN_POSTGRES_USER=postgres
# ADMIN_POSTGRES_DB=AdminDatabase

# Nom RÉEL du volume Docker, sans préfixe de projet. Le défaut (`sankore-admin-postgres-data`)
# convient aux deux cas, neuf comme repris : le volume de l'ancienne pile unique NE peut PAS
# être réutilisé tel quel — il était monté sur le parent de PGDATA et ne contient donc aucun
# cluster. La reprise se fait par `pg_dump` et restauration (§3 du runbook).
# ADMIN_POSTGRES_VOLUME=sankore-admin-postgres-data

# ── Clé d'entrée ────────────────────────────────────────────────────────────
# ↔ pile API : doit valoir exactement son `TENANTSTORE_APIKEY`, la clé avec laquelle elle
# appelle ce service. `openssl rand -hex 32`.
#
# VIDE N'EST PAS « PAS DE CLÉ » : `UseApiKeyAuth()` ne valide rien quand la valeur est absente,
# donc un oubli ici ouvre le référentiel de tenants à qui l'atteint.
SANKORE_API_KEY=

# ── Télémétrie ──────────────────────────────────────────────────────────────
# VIDE = pas d'exportateur enregistré, et c'est le défaut d'une pile déployée seule. Avec la
# pile principale sur la même machine : `http://env-dashboard:18889` (résolu par
# `dokploy-network`).
ADMIN_OTEL_EXPORTER_OTLP_ENDPOINT=

# ── Swagger du registre ─────────────────────────────────────────────────────
# Vide = Development seulement. `true` le publie, mais UNIQUEMENT derrière l'authentification
# Basic ci-dessous, et l'hôte répond 503 tant que le mot de passe manque.
ADMIN_SWAGGER_ENABLED=True
ADMIN_SWAGGER_AUTH_USERNAME=sankore-admin
ADMIN_SWAGGER_AUTH_PASSWORD=toygGYnvU2t3X9th

# ── Tenant par défaut, provisionné au démarrage ─────────────────────────────
# `TenantSeeder` crée ce tenant au premier démarrage. Idempotent.
#
# ↔ pile API : `DEFAULT_TENANT_FQDN` et `DEFAULT_TENANT_EMAIL` sont lues des DEUX côtés — c'est
# par le FQDN que `SystemUserSeeder` retrouve, dans ce registre, le tenant qu'il provisionne.
#
# LE PIÈGE : `DEFAULT_TENANT_FQDN` est l'ORIGINE DU FRONT, SCHÉMA COMPRIS
# (`https://crm.example.com`). Pas un hôte nu, et PAS l'hôte de l'API. Le navigateur estampille
# chaque appel avec `location.origin` et la recherche compare la chaîne ENTIÈRE : un hôte nu
# n'est jamais trouvé, et le symptôme est une 400 « Cannot determine tenant » sur chaque
# requête, sans rien d'anormal dans les journaux.
DEFAULT_TENANT_NAME=Sankore
DEFAULT_TENANT_FQDN=https://sankore-crm.talisoft.net
DEFAULT_TENANT_EMAIL=ambroise.bazie+system@outlook.com

# ↔ pile API, et LA valeur à ne pas perdre en séparant les piles : chaque ligne de la base de
# l'API porte cet identifiant. Laisser vide au PREMIER démarrage, lire l'identifiant dans les
# journaux (« TenantSeeder: provisioned tenant <id> ») ou dans `GET /api/v1/tenants`, puis le
# coller ici ET dans le `.env` principal. Un registre reconstruit sans lui en génère un
# nouveau, et tout l'historique devient invisible pour un tenant qui, vu de l'extérieur, est le
# même. Un identifiant qui ne correspond à aucun tenant existant est ignoré avec un
# avertissement, jamais imposé.
DEFAULT_TENANT_ID=
