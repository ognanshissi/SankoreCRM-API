<Project>

  <!--
    Picked up automatically by every .csproj under this directory.
    Centralizes settings that must be consistent across the whole modular
    monolith (nullable reference types, warnings-as-errors, code analysis)
    so no module can silently opt out of the quality bar.
  -->

  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- Fail the build on nullable warnings once the codebase is clean;
         start as warnings during initial development. -->
    <WarningsAsErrors>Nullable</WarningsAsErrors>

    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>

    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <NoWarn>CS1591</NoWarn>

    <!--
      Keep the default item globs out of the build output. The SDK already tries to: it appends
      "bin\Debug//**;obj\Debug//**" to DefaultItemExcludes — with a WINDOWS separator, because it
      builds those patterns from $(BaseOutputPath), whose default is "bin\". On macOS and Linux a
      backslash is an ordinary filename character, so those two patterns match nothing and the
      exclusion silently does nothing.

      For a library that is harmless. For a Web SDK project it is not: the web SDK includes
      "**/*.json" as Content by default, so appsettings.json, deps.json, runtimeconfig.json and
      the staticwebassets manifests get picked up FROM bin and copied one level deeper — into
      bin/Debug/net10.0/bin/Debug/net10.0/. Each build adds another level. We reached 71 levels
      and 161 files, and the build then failed with MSB3030 trying to copy a runtimeconfig.json
      out of a nested path that no longer held one.

      Forward slashes, which do match here. Repo-wide rather than per project, because any new
      host would inherit the same trap.
    -->
    <DefaultItemExcludes>$(DefaultItemExcludes);bin/**;obj/**</DefaultItemExcludes>
  </PropertyGroup>

  <!--
    Release gate. This used to be a blanket <TreatWarningsAsErrors>true</TreatWarningsAsErrors>,
    which gave a test method named with underscores the same power to stop a deploy as a
    package vulnerability. With ~2800 advisory warnings outstanding the gate was unreachable,
    so a Release build simply never ran — and NU1903 (a high-severity advisory on
    System.Security.Cryptography.Xml, reached through DataProtection) sat behind it unnoticed.

    An explicit list instead. Every family here is currently at ZERO, so it can only fire on a
    regression, and the rules NOT listed stay visible as warnings rather than being silenced
    with NoWarn. Promote a family into this list once it has been driven to zero; see the
    remaining ones in .editorconfig's closing comment.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <WarningsAsErrors>
      $(WarningsAsErrors);
      NU1605;NU1902;NU1903;
      CS0105;CS0618;CS9124;
      CA1001;CA1826;CA1861;
      NETSDK1080
    </WarningsAsErrors>
  </PropertyGroup>

</Project>
