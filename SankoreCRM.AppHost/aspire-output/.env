# Bind mount source for grafana:/etc/grafana/provisioning
GRAFANA_BINDMOUNT_0=

# Bind mount source for grafana:/var/lib/grafana/dashboards
GRAFANA_BINDMOUNT_1=

# Container image name for postgres
POSTGRES_IMAGE=sankore-postgres

# Parameter postgres-password
POSTGRES_PASSWORD=postgres

# Bind mount source for prometheus:/etc/prometheus/prometheus.yml
PROMETHEUS_BINDMOUNT_0=

# Parameter rabbitmq-password
RABBITMQ_PASSWORD=rabbitmq

# Parameter redis-password
REDIS_PASSWORD=redis

# Container image name for sankore-admin
SANKORE_ADMIN_IMAGE=

# Default container port for sankore-admin
SANKORE_ADMIN_PORT=

# Container image name for sankore-api
SANKORE_API_IMAGE=sankore-api

# Default container port for sankore-api
SANKORE_API_PORT=8080

# Container image name for sankore-hangfire
SANKORE_HANGFIRE_IMAGE=

# Default container port for sankore-hangfire
SANKORE_HANGFIRE_PORT=

# Bind mount source for tempo:/etc/tempo.yaml
TEMPO_BINDMOUNT_0=

