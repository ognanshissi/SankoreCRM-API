<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="FluentAssertions" Version="6.12.1" />
    <PackageVersion Include="MailKit" Version="4.17.0" />
    <PackageVersion Include="Microsoft.Extensions.ApiDescription.Client" Version="10.0.12">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageVersion>
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
    <PackageVersion Include="NSubstitute" Version="5.1.0" />
    <PackageVersion Include="xunit" Version="2.9.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>
  <ItemGroup Label="FluentValidation">
    <PackageVersion Include="FluentValidation" Version="11.10.0" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="11.10.0" />
  </ItemGroup>
  <ItemGroup Label="MassTransit">
    <PackageVersion Include="MassTransit" Version="8.3.2" />
    <PackageVersion Include="MassTransit.RabbitMQ" Version="8.3.2" />
  </ItemGroup>
  <ItemGroup Label="MediatR">
    <PackageVersion Include="MediatR" Version="12.4.1" />
  </ItemGroup>
  <ItemGroup Label="AspNetCore">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.12" />
    <!-- Deliberately held at 9.x while the rest of the stack is on 10.x. The 10.x line
         pulls Microsoft.OpenApi 2.x, which relocated the types out of
         Microsoft.OpenApi.Models / .Any and is incompatible with Swashbuckle 6.9.0 below.
         Moving it means migrating EnumSchemaFilter, TenantHeaderOperationFilter and
         OpenApiEmitter together with Swashbuckle -> 9.x, and the swagger document those
         emit is what SankoreFront generates its client from. Nothing in this package
         pulls the vulnerable System.Security.Cryptography.Xml. -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="9.0.0" />
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.12" />
    <!-- Persists the Data Protection key ring in Postgres. Without it the keys live in the
         container filesystem and every redeploy invalidates all outstanding activation /
         password-reset tokens. -->
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="EntityFrameworkCore">
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NetTopologySuite" Version="10.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.12" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.InMemory" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Label="Scriban">
    <PackageVersion Include="Scriban" Version="7.2.6" />
  </ItemGroup>
  <ItemGroup Label="Hangfire">
    <PackageVersion Include="Hangfire.Core" Version="1.8.17" />
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.17" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.20.10" />
  </ItemGroup>
  <ItemGroup Label="CsvHelper">
    <PackageVersion Include="CsvHelper" Version="33.0.1" />
    <PackageVersion Include="QuestPDF" Version="2024.12.2" />
    <PackageVersion Include="ncrontab" Version="3.3.3" />
  </ItemGroup>
  <ItemGroup Label="GeneratedClients">
    <!-- The biometry client generated at build time from biometry-openapi.json (Sankore.Api).
         Microsoft.Extensions.ApiDescription.Client only declares the OpenApiReference item and
         then calls a target named Generate<CodeGenerator>; NSwag.ApiDescription.Client is what
         supplies GenerateNSwagCSharp. Without it the build fails with
         "MSB4057: The target GenerateNSwagCSharp does not exist in the project", which names
         neither package. -->
    <PackageVersion Include="NSwag.ApiDescription.Client" Version="14.7.1" />
  </ItemGroup>
  <ItemGroup Label="SecurityOverrides">
    <!-- Hangfire.Core drags in 11.0.1, which is vulnerable; this pin overrides it.
         Floor raised to 13.0.4 by Microsoft.EntityFrameworkCore.Design 10.x, which
         requires >= 13.0.4 — 13.0.3 now restores as a downgrade (NU1605). -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>
  <ItemGroup Label="Google">
    <PackageVersion Include="ClosedXML" Version="0.104.2" />
    <PackageVersion Include="Google.Apis.Sheets.v4" Version="1.69.0.3694" />
    <PackageVersion Include="Google.Apis.PeopleService.v1" Version="1.69.0.3785" />
  </ItemGroup>
  <ItemGroup Label="Extensions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Localization" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options" Version="10.0.12" />
    <!-- Explicit rather than transitive via Kernel -> EF Core: the object-storage
         projects read their own configuration section and must not depend on an
         ORM happening to drag it in. -->
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
    <!-- Cloudflare R2 speaks the S3 API; this is the client, pointed at an R2 ServiceURL.
         Referenced ONLY by Sankore.Shared.ObjectStorage.S3, so the two hosts that store no
         object never ship it. -->
    <PackageVersion Include="AWSSDK.S3" Version="4.0.104" />
  </ItemGroup>
  <!--  Aspire  -->
  <ItemGroup Label="Aspire">
    <PackageVersion Include="Aspire.Hosting.Docker" Version="13.5.2" />
    <PackageVersion Include="Aspire.Hosting.Seq" Version="13.4.6" />
    <PackageVersion Include="Aspire.Seq" Version="13.4.6" />
    <PackageVersion Include="Aspire.StackExchange.Redis.DistributedCaching" Version="13.4.6" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.8.0" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.17.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.17.0" />
    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.RabbitMQ" Version="13.4.6" />
    <PackageVersion Include="Aspire.Hosting.Redis" Version="13.4.6" />
  </ItemGroup>
</Project>