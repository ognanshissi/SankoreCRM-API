# =============================================================================
# .env.backup.example — Required variables for the SankoreCRM backup service
#
# Copy to .env.backup and fill in real values.
# NEVER commit .env.backup to version control.
# In production, inject secrets via Docker secrets or your secrets manager.
# =============================================================================

# ── PostgreSQL connection ─────────────────────────────────────────────────────
PGHOST=postgres
PGPORT=5432
PGDATABASE=sankore_crm
PGUSER=sankore_app
PGPASSWORD=CHANGE_ME

# ── Encryption ───────────────────────────────────────────────────────────────
# Minimum 32 characters. Generate with: openssl rand -base64 48
BACKUP_ENCRYPTION_PASSPHRASE=CHANGE_ME_generate_with_openssl_rand_base64_48

# ── Storage ───────────────────────────────────────────────────────────────────
# Use an S3 URI for production, a local path for dev/staging:
#   Production:  s3://sankore-backups/daily
#   Dev/staging: /mnt/backups
BACKUP_STORAGE_PATH=/mnt/backups

# ── S3-compatible object storage (leave blank for local storage) ──────────────
# MinIO (local dev):
#   AWS_ENDPOINT_URL=http://minio:9000
#   AWS_ACCESS_KEY_ID=minioadmin
#   AWS_SECRET_ACCESS_KEY=minioadmin
# Scaleway Object Storage:
#   AWS_ENDPOINT_URL=https://s3.fr-par.scw.cloud
#   AWS_DEFAULT_REGION=fr-par
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-1

# ── Restoration drill tuning ──────────────────────────────────────────────────
RESTORE_PG_VERSION=17-alpine
RESTORE_PORT=15432
