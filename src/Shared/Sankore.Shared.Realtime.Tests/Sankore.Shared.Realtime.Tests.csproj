<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <RootNamespace>Sankore.Shared.Realtime.Tests</RootNamespace>

    <!--
      Microsoft.NET.Sdk.Web and not Microsoft.NET.Sdk, for the same reason the project under test
      is: Hub, IHubContext and DefaultHttpContext live in the ASP.NET Core shared framework.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NSubstitute" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sankore.Shared.Realtime\Sankore.Shared.Realtime.csproj" />
  </ItemGroup>

</Project>
