{
  "components": {
    "schemas": {
      "Anomaly": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Code stable, ex. VISUAL_MRZ_MISMATCH",
            "title": "Code",
            "type": "string"
          },
          "field": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Field"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          }
        },
        "required": [
          "code",
          "severity"
        ],
        "title": "Anomaly",
        "type": "object"
      },
      "Channel": {
        "enum": [
          "BRANCH",
          "FIELD_AGENT",
          "REMOTE"
        ],
        "title": "Channel",
        "type": "string"
      },
      "ConfidenceLevel": {
        "enum": [
          "VALIDATED",
          "REVIEW_REQUIRED",
          "REJECTED"
        ],
        "title": "ConfidenceLevel",
        "type": "string"
      },
      "DocType": {
        "enum": [
          "CNI",
          "PASSPORT",
          "CEDEAO",
          "CONSULAIRE"
        ],
        "title": "DocType",
        "type": "string"
      },
      "ErrorDetail": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "details": {
            "default": null,
            "title": "Details"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorDetail",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        },
        "required": [
          "error"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "FaceMatchRequest": {
        "additionalProperties": false,
        "properties": {
          "doc_face_base64": {
            "anyOf": [
              {
                "minLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Photo de la pièce déjà recadrée",
            "title": "Doc Face Base64"
          },
          "doc_image_base64": {
            "anyOf": [
              {
                "minLength": 100,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "Image complète de la pièce ; le visage principal en est extrait",
            "title": "Doc Image Base64"
          },
          "selfie_base64": {
            "minLength": 100,
            "title": "Selfie Base64",
            "type": "string"
          }
        },
        "required": [
          "selfie_base64"
        ],
        "title": "FaceMatchRequest",
        "type": "object"
      },
      "FaceMatchResponse": {
        "additionalProperties": false,
        "properties": {
          "detection_scores": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Detection Scores",
            "type": "object"
          },
          "is_match": {
            "title": "Is Match",
            "type": "boolean"
          },
          "model_versions": {
            "$ref": "#/components/schemas/ModelVersions"
          },
          "quality": {
            "$ref": "#/components/schemas/FaceQuality"
          },
          "similarity_score": {
            "description": "Similarité cosinus des embeddings",
            "maximum": 1,
            "minimum": -1,
            "title": "Similarity Score",
            "type": "number"
          },
          "threshold": {
            "title": "Threshold",
            "type": "number"
          }
        },
        "required": [
          "similarity_score",
          "is_match",
          "threshold",
          "detection_scores",
          "quality",
          "model_versions"
        ],
        "title": "FaceMatchResponse",
        "type": "object"
      },
      "FaceQuality": {
        "additionalProperties": false,
        "properties": {
          "document": {
            "$ref": "#/components/schemas/QualityInfo"
          },
          "selfie": {
            "$ref": "#/components/schemas/QualityInfo"
          }
        },
        "required": [
          "selfie",
          "document"
        ],
        "title": "FaceQuality",
        "type": "object"
      },
      "FieldValue": {
        "additionalProperties": false,
        "properties": {
          "confidence": {
            "maximum": 1,
            "minimum": 0,
            "title": "Confidence",
            "type": "number"
          },
          "low_confidence": {
            "default": false,
            "title": "Low Confidence",
            "type": "boolean"
          },
          "source": {
            "description": "VISUAL ou MRZ",
            "title": "Source",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Value"
          }
        },
        "required": [
          "value",
          "confidence",
          "source"
        ],
        "title": "FieldValue",
        "type": "object"
      },
      "Flag": {
        "additionalProperties": false,
        "properties": {
          "blocking": {
            "title": "Blocking",
            "type": "boolean"
          },
          "code": {
            "title": "Code",
            "type": "string"
          },
          "severity": {
            "$ref": "#/components/schemas/Severity"
          }
        },
        "required": [
          "code",
          "severity",
          "blocking"
        ],
        "title": "Flag",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "model_versions": {
            "anyOf": [
              {
                "additionalProperties": {
                  "type": "string"
                },
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Model Versions"
          },
          "status": {
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "ModelVersions": {
        "additionalProperties": true,
        "properties": {
          "service": {
            "title": "Service",
            "type": "string"
          }
        },
        "required": [
          "service"
        ],
        "title": "ModelVersions",
        "type": "object"
      },
      "MrzCheckOut": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "title": "Field",
            "type": "string"
          },
          "valid": {
            "title": "Valid",
            "type": "boolean"
          }
        },
        "required": [
          "field",
          "valid"
        ],
        "title": "MrzCheckOut",
        "type": "object"
      },
      "MrzData": {
        "additionalProperties": false,
        "properties": {
          "birth_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Birth Date"
          },
          "checks": {
            "items": {
              "$ref": "#/components/schemas/MrzCheckOut"
            },
            "title": "Checks",
            "type": "array"
          },
          "checksums_valid": {
            "title": "Checksums Valid",
            "type": "boolean"
          },
          "document_code": {
            "title": "Document Code",
            "type": "string"
          },
          "document_number": {
            "title": "Document Number",
            "type": "string"
          },
          "expiry_date": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Expiry Date"
          },
          "first_name": {
            "title": "First Name",
            "type": "string"
          },
          "format": {
            "title": "Format",
            "type": "string"
          },
          "issuing_country": {
            "title": "Issuing Country",
            "type": "string"
          },
          "last_name": {
            "title": "Last Name",
            "type": "string"
          },
          "nationality": {
            "title": "Nationality",
            "type": "string"
          },
          "sex": {
            "title": "Sex",
            "type": "string"
          }
        },
        "required": [
          "format",
          "checksums_valid",
          "checks",
          "document_code",
          "issuing_country",
          "document_number",
          "birth_date",
          "sex",
          "expiry_date",
          "nationality",
          "last_name",
          "first_name"
        ],
        "title": "MrzData",
        "type": "object"
      },
      "OcrRequest": {
        "additionalProperties": false,
        "properties": {
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "image_base64": {
            "description": "Image JPG/PNG/WEBP encodée en base64 (préfixe data: accepté)",
            "minLength": 100,
            "title": "Image Base64",
            "type": "string"
          }
        },
        "required": [
          "image_base64",
          "doc_type"
        ],
        "title": "OcrRequest",
        "type": "object"
      },
      "OcrResponse": {
        "additionalProperties": false,
        "properties": {
          "anomalies": {
            "items": {
              "$ref": "#/components/schemas/Anomaly"
            },
            "title": "Anomalies",
            "type": "array"
          },
          "doc_type": {
            "$ref": "#/components/schemas/DocType"
          },
          "fields": {
            "additionalProperties": {
              "$ref": "#/components/schemas/FieldValue"
            },
            "title": "Fields",
            "type": "object"
          },
          "model_versions": {
            "$ref": "#/components/schemas/ModelVersions"
          },
          "mrz": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/MrzData"
              },
              {
                "type": "null"
              }
            ]
          },
          "quality": {
            "$ref": "#/components/schemas/QualityInfo"
          }
        },
        "required": [
          "doc_type",
          "fields",
          "mrz",
          "anomalies",
          "quality",
          "model_versions"
        ],
        "title": "OcrResponse",
        "type": "object"
      },
      "QualityInfo": {
        "additionalProperties": false,
        "properties": {
          "causes": {
            "description": "TOO_BLURRY, UNDEREXPOSED, OVEREXPOSED, GLARE, LOW_CONTRAST",
            "items": {
              "type": "string"
            },
            "title": "Causes",
            "type": "array"
          },
          "preprocessed": {
            "title": "Preprocessed",
            "type": "boolean"
          },
          "score": {
            "maximum": 1,
            "minimum": 0,
            "title": "Score",
            "type": "number"
          }
        },
        "required": [
          "score",
          "preprocessed"
        ],
        "title": "QualityInfo",
        "type": "object"
      },
      "RiskLevel": {
        "enum": [
          "LOW",
          "STANDARD",
          "HIGH"
        ],
        "title": "RiskLevel",
        "type": "string"
      },
      "ScoreComponent": {
        "additionalProperties": false,
        "properties": {
          "points": {
            "title": "Points",
            "type": "number"
          },
          "ratio": {
            "maximum": 1,
            "minimum": 0,
            "title": "Ratio",
            "type": "number"
          },
          "weight": {
            "title": "Weight",
            "type": "number"
          }
        },
        "required": [
          "ratio",
          "weight",
          "points"
        ],
        "title": "ScoreComponent",
        "type": "object"
      },
      "ScoreRequest": {
        "additionalProperties": false,
        "description": "Le module .NET renvoie tels quels les résultats de /v1/ocr et /v1/face-match,\néventuellement après correction de champs par l'agent.",
        "properties": {
          "channel": {
            "$ref": "#/components/schemas/Channel"
          },
          "corrected_fields": {
            "description": "Champs corrigés par l'agent",
            "items": {
              "type": "string"
            },
            "title": "Corrected Fields",
            "type": "array"
          },
          "face_result": {
            "$ref": "#/components/schemas/FaceMatchResponse"
          },
          "ocr_result": {
            "$ref": "#/components/schemas/OcrResponse"
          },
          "risk_level": {
            "$ref": "#/components/schemas/RiskLevel"
          }
        },
        "required": [
          "ocr_result",
          "face_result",
          "channel",
          "risk_level"
        ],
        "title": "ScoreRequest",
        "type": "object"
      },
      "ScoreResponse": {
        "additionalProperties": false,
        "properties": {
          "breakdown": {
            "additionalProperties": {
              "$ref": "#/components/schemas/ScoreComponent"
            },
            "title": "Breakdown",
            "type": "object"
          },
          "flags": {
            "items": {
              "$ref": "#/components/schemas/Flag"
            },
            "title": "Flags",
            "type": "array"
          },
          "global_score": {
            "maximum": 100,
            "minimum": 0,
            "title": "Global Score",
            "type": "integer"
          },
          "level": {
            "$ref": "#/components/schemas/ConfidenceLevel"
          },
          "model_versions": {
            "$ref": "#/components/schemas/ModelVersions"
          },
          "penalties": {
            "title": "Penalties",
            "type": "integer"
          }
        },
        "required": [
          "global_score",
          "level",
          "breakdown",
          "penalties",
          "flags",
          "model_versions"
        ],
        "title": "ScoreResponse",
        "type": "object"
      },
      "Severity": {
        "enum": [
          "MAJOR",
          "MINOR",
          "INFO"
        ],
        "title": "Severity",
        "type": "string"
      },
      "ValidationErrorModel": {
        "properties": {
          "ctx": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "An optional object which contains values required to render the error message.",
            "title": "Error context"
          },
          "input": {
            "description": "The input provided for validation.",
            "title": "Input"
          },
          "loc": {
            "description": "The error's location as a list.",
            "items": {},
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "description": "A human readable explanation of the error.",
            "title": "Message",
            "type": "string"
          },
          "type": {
            "description": "A computer-readable identifier of the error type.",
            "title": "Error Type",
            "type": "string"
          },
          "url": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "description": "The URL to further information about the error.",
            "title": "URL"
          }
        },
        "required": [
          "type",
          "loc",
          "msg",
          "input"
        ],
        "title": "ValidationErrorModel",
        "type": "object"
      }
    },
    "securitySchemes": {
      "service_token": {
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "title": "SANKORE biometry-service",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/health": {
      "get": {
        "operationId": "health_health_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationErrorModel"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Unprocessable Entity"
          }
        },
        "summary": "Le processus répond (sonde de vie).",
        "tags": [
          "Santé"
        ]
      }
    },
    "/ready": {
      "get": {
        "operationId": "health_ready_ready_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "OK"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/ValidationErrorModel"
                  },
                  "type": "array"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Les modèles sont chargés et le service peut traiter des requêtes (sonde de disponibilité).",
        "tags": [
          "Santé"
        ]
      }
    },
    "/v1/face-match": {
      "post": {
        "operationId": "face_face_match_face_match_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/FaceMatchRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FaceMatchResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "service_token": []
          }
        ],
        "summary": "Compare le selfie avec la photo de la pièce (recadrée ou image complète).",
        "tags": [
          "Visage"
        ]
      }
    },
    "/v1/ocr": {
      "post": {
        "operationId": "ocr_ocr_ocr_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OcrRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OcrResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "service_token": []
          }
        ],
        "summary": "Lit une pièce d'identité : champs visuels, MRZ décodée et anomalies.",
        "tags": [
          "OCR"
        ]
      }
    },
    "/v1/score": {
      "post": {
        "operationId": "score_score_score_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScoreRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScoreResponse"
                }
              }
            },
            "description": "OK"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request Entity Too Large"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unprocessable Entity"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "security": [
          {
            "service_token": []
          }
        ],
        "summary": "Calcule le score de confiance à partir des résultats OCR et visage. Aucune inférence.",
        "tags": [
          "Score"
        ]
      }
    }
  },
  "tags": [
    {
      "name": "Santé"
    },
    {
      "name": "OCR"
    },
    {
      "name": "Visage"
    },
    {
      "name": "Score"
    }
  ]
}