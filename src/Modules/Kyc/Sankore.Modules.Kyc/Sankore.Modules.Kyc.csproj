<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sankore.Modules.Kyc</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Hangfire.Core" />
    <!-- Hangfire.Core drags Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr). Pinned direct
         reference to 13.0.3, same override the other modules apply. -->
    <PackageReference Include="Newtonsoft.Json" />
    <!-- Resilience for the biometry HTTP client (same stack as the Leads puller). -->
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" />

    <!-- Biometry client generated from the service's own OpenAPI document, below. Declared HERE
         and not in the bootstrapper: HttpBiometryClient is the consumer and lives in this module,
         and a module may not reference a host. Both packages are build-time only. -->
    <PackageReference Include="Microsoft.Extensions.ApiDescription.Client">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NSwag.ApiDescription.Client" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Flask biometric service's contract, checked in next to the client that calls it.
         Regenerated on every build, so a service-side rename breaks the build instead of
         silently yielding nulls — which is exactly what the previous hand-written wire records
         did: not one of their field names matched this document.

         SingleClientFromPathSegments: the default emits one class per tag (OCR, Santé, Score,
         Visage) while ClassName imposes one name, so the four collided and nothing compiled.
         UseHttpRequestMessageCreationMethod: lets BiometryApiClient override the request factory
         to add the per-tenant bearer token and the correlation header, which NSwag has no other
         hook for. JsonLibrary: this module serialises with System.Text.Json everywhere else. -->
    <OpenApiReference Include="Infrastructure\Biometry\biometry-openapi.json"
                      CodeGenerator="NSwagCSharp"
                      ClassName="BiometryGeneratedClient"
                      Namespace="Sankore.Modules.Kyc.Infrastructure.Biometry.Generated">
      <Options>/GenerateClientInterfaces:true /GenerateDtoTypes:true /OperationGenerationMode:SingleClientFromPathSegments /UseHttpRequestMessageCreationMethod:true /JsonLibrary:SystemTextJson /GenerateOptionalParameters:false</Options>
    </OpenApiReference>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Sankore.Shared.Kernel\Sankore.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\Sankore.Shared.Infrastructure\Sankore.Shared.Infrastructure.csproj" />
    <!-- Object storage behind IObjectBackend. Its own project so the S3 SDK reaches only
         what stores objects: Sankore.Shared.Infrastructure is referenced by every host,
         including Sankore.Admin and Sankore.Hangfire, and neither stores one. -->
    <ProjectReference Include="..\..\..\Shared\Sankore.Shared.ObjectStorage\Sankore.Shared.ObjectStorage.csproj" />
    <ProjectReference Include="..\Sankore.Modules.Kyc.PublicApi\Sankore.Modules.Kyc.PublicApi.csproj" />
    <!-- Cross-module dependencies: PublicApi contracts ONLY, never a main assembly -->
    <ProjectReference Include="..\..\Administration\Sankore.Modules.Administration.PublicApi\Sankore.Modules.Administration.PublicApi.csproj" />
    <ProjectReference Include="..\..\Notifications\Sankore.Modules.Notifications.PublicApi\Sankore.Modules.Notifications.PublicApi.csproj" />
    <ProjectReference Include="..\..\Workflow\Sankore.Modules.Workflow.PublicApi\Sankore.Modules.Workflow.PublicApi.csproj" />
    <ProjectReference Include="..\..\Customers\Sankore.Modules.Customers.PublicApi\Sankore.Modules.Customers.PublicApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sankore.Modules.Kyc.Tests" />
    <!-- NSubstitute proxies this module's internal interfaces (IKycDocumentStore, IBiometryClient).
         Castle generates those proxies into DynamicProxyGenAssembly2, which needs its own grant —
         without it a substitute fails at RUNTIME with "Can not create proxy ... not accessible",
         not at compile time. Same line as Sankore.Modules.Notifications. -->
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
