<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sankore.Modules.Customers</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
    <PackageReference Include="Microsoft.Extensions.Localization" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Hangfire.Core" />
    <!-- Hangfire.Core drags Newtonsoft.Json 11.0.1 (GHSA-5crp-9r3c-p9vr). Pinned direct
         reference to 13.0.3, same override the other modules apply. -->
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="CsvHelper" />
    <!-- Bulk client import: .xlsx reading and Google Sheets, same sources as the user import. -->
    <PackageReference Include="ClosedXML" />
    <PackageReference Include="Google.Apis.Sheets.v4" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Shared\Sankore.Shared.Kernel\Sankore.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\..\Shared\Sankore.Shared.Infrastructure\Sankore.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\Sankore.Modules.Customers.PublicApi\Sankore.Modules.Customers.PublicApi.csproj" />
    <!-- Cross-module dependencies: PublicApi contracts ONLY, never a main assembly -->
    <ProjectReference Include="..\..\Administration\Sankore.Modules.Administration.PublicApi\Sankore.Modules.Administration.PublicApi.csproj" />
    <ProjectReference Include="..\..\Notifications\Sankore.Modules.Notifications.PublicApi\Sankore.Modules.Notifications.PublicApi.csproj" />
    <ProjectReference Include="..\..\Workflow\Sankore.Modules.Workflow.PublicApi\Sankore.Modules.Workflow.PublicApi.csproj" />
    <ProjectReference Include="..\..\Kyc\Sankore.Modules.Kyc.PublicApi\Sankore.Modules.Kyc.PublicApi.csproj" />
    <ProjectReference Include="..\..\Customer360\Sankore.Modules.Customer360.PublicApi\Sankore.Modules.Customer360.PublicApi.csproj" />
    <!-- Leads PublicApi: lead commercial-history import into the client timeline (US-M01-BE-26 / F13.29) -->
    <ProjectReference Include="..\..\Leads\Sankore.Modules.Leads.PublicApi\Sankore.Modules.Leads.PublicApi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Sankore.Modules.Customers.Tests" />
  </ItemGroup>

</Project>
