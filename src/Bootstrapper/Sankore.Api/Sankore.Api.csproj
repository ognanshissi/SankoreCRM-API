<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sankore.Api</RootNamespace>
    <UserSecretsId>sankore-crm-api-local</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.9.0" />
    <PackageReference Include="MassTransit" Version="8.3.2" />
    <PackageReference Include="MassTransit.RabbitMQ" Version="8.3.2" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Bootstrapper is the ONLY project allowed to reference every
         module's MAIN assembly (to call Add{Module}Module / Map{Module}Endpoints).
         It never reaches into a module's Domain/Infrastructure/Features
         namespaces directly. -->
    <ProjectReference Include="..\..\Shared\Sankore.Shared.Kernel\Sankore.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Sankore.Shared.Infrastructure\Sankore.Shared.Infrastructure.csproj" />
    <ProjectReference Include="..\..\Modules\Users\Sankore.Modules.Users\Sankore.Modules.Users.csproj" />
    <ProjectReference Include="..\..\Modules\Leads\Sankore.Modules.Leads\Sankore.Modules.Leads.csproj" />
  </ItemGroup>

</Project>
