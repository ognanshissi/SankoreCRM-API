<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sankore.Api</RootNamespace>
    <UserSecretsId>sankore-crm-api-local</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Seq" />
    <PackageReference Include="Aspire.StackExchange.Redis.DistributedCaching" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Swashbuckle.AspNetCore" />
    <PackageReference Include="MassTransit" />
    <PackageReference Include="MassTransit.RabbitMQ" />
    <PackageReference Include="EFCore.NamingConventions" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" />
    <PackageReference Include="Hangfire.AspNetCore" />
    <PackageReference Include="Hangfire.PostgreSql" />
  </ItemGroup>

  <ItemGroup>
    <!-- The Bootstrapper is the ONLY project allowed to reference every
         module's MAIN assembly (to call Add{Module}Module / Map{Module}Endpoints).
         It never reaches into a module's Domain/Infrastructure/Features
         namespaces directly. -->
    <ProjectReference Include="..\..\Shared\Sankore.Shared.Kernel\Sankore.Shared.Kernel.csproj" />
    <ProjectReference Include="..\..\Shared\Sankore.Shared.Infrastructure\Sankore.Shared.Infrastructure.csproj" />
    <!-- The S3/R2 client. Referenced HERE and nowhere else: this is the only host that puts
         an object in a bucket, so Sankore.Admin and Sankore.Hangfire ship no AWS client. -->
    <ProjectReference Include="..\..\Shared\Sankore.Shared.ObjectStorage.S3\Sankore.Shared.ObjectStorage.S3.csproj" />
    <ProjectReference Include="..\..\Modules\Administration\Sankore.Modules.Administration\Sankore.Modules.Administration.csproj" />
    <ProjectReference Include="..\..\Modules\Leads\Sankore.Modules.Leads\Sankore.Modules.Leads.csproj" />
    <ProjectReference Include="..\..\Modules\Workflow\Sankore.Modules.Workflow\Sankore.Modules.Workflow.csproj" />
    <ProjectReference Include="..\..\Modules\Notifications\Sankore.Modules.Notifications\Sankore.Modules.Notifications.csproj" />
    <ProjectReference Include="..\..\Modules\Customers\Sankore.Modules.Customers\Sankore.Modules.Customers.csproj" />
    <!-- PublicApi-only references for modules not yet scaffolded (stubs registered) -->
    <ProjectReference Include="..\..\Modules\Customer360\Sankore.Modules.Customer360.PublicApi\Sankore.Modules.Customer360.PublicApi.csproj" />
    <ProjectReference Include="..\..\Modules\Kyc\Sankore.Modules.Kyc.PublicApi\Sankore.Modules.Kyc.PublicApi.csproj" />
    <ProjectReference Include="..\..\Modules\Kyc\Sankore.Modules.Kyc\Sankore.Modules.Kyc.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration\Sankore.Modules.Integration.csproj" />
    <!-- The core-banking adapters. A reference here only puts the assembly in the output; what
         makes an adapter reachable by a connection is the matching Add...Adapter call, collected
         in IntegrationAdapterComposition and pinned by IntegrationAdapterCompositionTests.
         The in-memory one is registered in Development only, by AddFakeAdapter itself, which
         refuses to run anywhere else: a deployment that reached it would report writes to a core
         banking system that never happened. -->
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.Temenos\Sankore.Modules.Integration.Adapters.Temenos.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.Fake\Sankore.Modules.Integration.Adapters.Fake.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.PerfectVision\Sankore.Modules.Integration.Adapters.PerfectVision.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.Amplitude\Sankore.Modules.Integration.Adapters.Amplitude.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.Sab\Sankore.Modules.Integration.Adapters.Sab.csproj" />
    <ProjectReference Include="..\..\Modules\Integration\Sankore.Modules.Integration.Adapters.Orass\Sankore.Modules.Integration.Adapters.Orass.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\..\.dockerignore">
      <Link>.dockerignore</Link>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Infrastructure\Audit\Migrations\" />
  </ItemGroup>

  <ItemGroup>
    <!-- The host owns decision logic of its own now (the object-storage migration guards), and
         those types are internal like every slice's. -->
    <InternalsVisibleTo Include="Sankore.Api.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>

</Project>
