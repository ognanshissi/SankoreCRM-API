{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore": "Warning",
      "MassTransit": "Warning",
      "Sankore": "Information"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=Database;Username=postgres;Password=postgres"
  },
  
  "TenantStore": {
    "BaseUrl": "https://localhost:7181",
    "CacheTtl": "00:05:00"
  },

  "Jwt": {
    "Issuer": "https://auth.sankore-crm.local",
    "Audience": "sankore-crm-api",
    "SigningKey": "CHANGE_ME_use_dotnet_user-secrets_or_Key_Vault_in_real_environments"
  },
  
  "seq": {
    "ServerUrl": ""
  },

  "Messaging": {
    "UseRabbitMq": false,
    "RabbitMqHost": "localhost",
    "RABBITMQ_DEFAULT_USER": "guest",
    "RABBITMQ_DEFAULT_PASS": "guest"
  }
}
