{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=sankorecrm_db;Username=postgres;Password=postgres"
  },

  "Jwt": {
    "Issuer": "https://auth.sankore-crm.local",
    "Audience": "sankore-crm-api",
    "SigningKey": "CHANGE_ME_use_dotnet_user-secrets_or_Key_Vault_in_real_environments"
  },

  "Messaging": {
    "UseRabbitMq": false,
    "RabbitMqHost": "localhost",
    "RABBITMQ_DEFAULT_USER": "guest",
    "RABBITMQ_DEFAULT_PASS": "guest"
  }
}
