{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Sankore": "Debug",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=Database;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "UseRabbitMq": false
  },
  "TenantStore": {
    "BaseUrl": "https://localhost:7181",
    "CacheTtl": "00:05:00"
  },
  "Notifications": {
    "OutboxProcessor": {
      "BatchSize": 50,
      "PollingIntervalSeconds": 30,
      "MaxAttempts": 3
    }
  }
}