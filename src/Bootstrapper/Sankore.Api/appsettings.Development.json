{
  "Logging": {
    "LogLevel": {
      "Default": "Debug",
      "Sankore": "Debug",
      "Microsoft.AspNetCore.HttpLogging": "Information",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "ConnectionStrings": {
    "Database": "Host=localhost;Port=5432;Database=Database;Username=postgres;Password=postgres"
  },
  "Messaging": {
    "UseRabbitMq": false
  },

  "Jwt": {
    "Issuer": "https://auth.sankore-crm.local",
    "Audience": "sankore-crm-api",
    "SigningKey": "CHANGE_ME_use_dotnet_user-secrets_or_Key_Vault_in_real_environments"
  },
  
  "TenantStore": {
    "BaseUrl": "http://localhost:5200/",
    "CacheTtl": "00:05:00"
  },
  "Notifications": {
    "OutboxProcessor": {
      "BatchSize": 50,
      "PollingIntervalSeconds": 30,
      "MaxAttempts": 3
    }
  }
}